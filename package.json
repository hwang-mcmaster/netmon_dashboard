{
  "name": "netmon-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build -w client",
    "lint": "eslint .",
    "check:config": "node scripts/check-config.js",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm test -w server",
    "test:integration": "npm run test:integration -w server",
    "test:e2e": "playwright test",
    "migrate": "npm run migrate -w server",
    "seed": "node --env-file-if-exists=.env server/src/seed.js",
    "start": "npm start -w server",
    "worker": "npm run worker -w server",
    "demo": "npm run demo -w server",
    "benchmark": "npm run benchmark -w server"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "eslint": "10.12.0",
    "prettier": "3.6.2",
    "yaml": "2.9.1"
  }
}
