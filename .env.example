# Native development. Replace the password; never commit .env.
DATABASE_URL=postgresql://netmon:replace-me@127.0.0.1:5432/netmon
DB_POOL_MAX=5
HOST=127.0.0.1
PORT=4000
# Required (24+ characters) when binding beyond loopback; browser enters it in memory.
API_TOKEN=
WORKER_CONCURRENCY=4
WORKER_POLL_MS=500
# Exact comma-separated DNS names or IPs; no wildcard discovery.
PROBE_ALLOWED_HOSTS=127.0.0.1
# Enables only explicit synthetic loopback checks; requires sink delivery.
DEMO_MODE=true
NOTIFICATION_CHANNEL=sink
WEBHOOK_URL=
RETENTION_DAYS=30
WEBHOOK_TOKEN=
