{
  "name": "netmon-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env src/index.js",
    "start": "node --env-file-if-exists=../.env src/index.js",
    "worker": "node --env-file-if-exists=../.env src/worker.js",
    "migrate": "node --env-file-if-exists=../.env src/migrate.js",
    "seed": "node --env-file-if-exists=../.env src/seed.js",
    "demo": "node src/demo.js",
    "test": "node --test test/unit.test.js test/probes.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js",
    "benchmark": "node --env-file-if-exists=../.env scripts/benchmark.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  }
}
